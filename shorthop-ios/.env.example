# Copy this file to .env and fill in your values.
# Get Firebase values from: Firebase Console → Project Settings → Your Apps
# Get Google client IDs from: Google Cloud Console → APIs & Services → Credentials

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Local dev: http://localhost:5000  |  Production: https://your-deployed-url.com
EXPO_PUBLIC_API_URL=http://localhost:5000

# Set to true to bypass auth during development (never true in production)
EXPO_PUBLIC_SKIP_AUTH=false
